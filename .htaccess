# ============================================================
# Campus Map - IONOS / Apache config
# ============================================================
# Erlaubt das Einbetten der Campus Map per <iframe> auf:
#   - hm-techlab.de (eigene Seite)
#   - train-on.net (Empfaenger-Seite)
# Andere Domains werden vom Browser blockiert.
# ------------------------------------------------------------

<IfModule mod_headers.c>
    # Moderne, von allen aktuellen Browsern unterstuetzte Regel.
    # 'self' = gleicher Host (hm-techlab.de)
    Header always set Content-Security-Policy "frame-ancestors 'self' https://train-on.net https://www.train-on.net https://hm-techlab.de https://www.hm-techlab.de"

    # X-Frame-Options entfernen (laesst nur eine Domain zu und wuerde CSP widersprechen).
    Header always unset X-Frame-Options

    # Caching: HTML nicht cachen (damit Updates sofort sichtbar sind),
    # Assets duerfen aggressiv gecached werden.
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(css|js|svg|png|jpg|jpeg|webp|woff2?|json)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

# Korrekte MIME-Types fuer Lottie-JSON und SVG (IONOS setzt das meistens schon,
# aber zur Sicherheit explizit).
<IfModule mod_mime.c>
    AddType application/json   .json
    AddType image/svg+xml      .svg
</IfModule>

# Komprimierung an (spart Bandbreite, schneller laden im iframe).
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# UTF-8 als Default-Encoding fuer Textdateien.
AddDefaultCharset UTF-8
